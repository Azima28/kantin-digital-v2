# Kantin Digital v2.0 -- environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; never commit real credentials.

# --- PostgreSQL -------------------------------------------------------------
# POSTGRES_PASSWORD is read by the postgres image ONLY when the data volume is
# created. Changing it later does not re-key an existing volume -- you must run
#   docker compose exec postgres psql -U postgres -c "ALTER USER postgres WITH PASSWORD '<new>';"
# and update this file to match.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-generate-a-long-random-value
POSTGRES_DB=kantin_digital

# --- API --------------------------------------------------------------------
# Signs every access token. Rotating it invalidates all sessions, which is the
# desired effect if the old secret ever leaked.
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-value
JWT_EXPIRY_HOURS=72

# Comma separated list of allowed browser origins. "*" combined with cookie
# auth lets any site issue credentialed requests on a logged-in user's behalf,
# so prefer an explicit list in production.
#   CORS_ORIGINS=https://zitech.web.id,https://kantin.zitech.web.id
CORS_ORIGINS=https://zitech.web.id,https://kantin.zitech.web.id

# development | production. "production" makes JWT_SECRET mandatory and turns
# off the localhost CORS allowance.
APP_ENV=production

# --- Cloudflare Tunnel -------------------------------------------------
# Dipakai service `cloudflared` di docker-compose.yml untuk menerbitkan
# nginx ke internet tanpa membuka port di router. Buat/lihat tunnel dengan:
#   cloudflared tunnel login
#   cloudflared tunnel create kantin-digital
#   cloudflared tunnel route dns kantin-digital kantin.zitech.web.id
# `tunnel create` menulis file kredensial <uuid>.json ke ~/.cloudflared --
# file itu memuat TunnelSecret, jangan pernah commit. Isi path absolutnya di
# CLOUDFLARE_TUNNEL_CREDENTIALS (pakai garis miring maju, juga di Windows).
# Hostname-nya sendiri diatur di cloudflared/config.yml.
CLOUDFLARE_TUNNEL_ID=change-me-tunnel-uuid
CLOUDFLARE_TUNNEL_CREDENTIALS=C:/Users/<user>/.cloudflared/change-me-tunnel-uuid.json
